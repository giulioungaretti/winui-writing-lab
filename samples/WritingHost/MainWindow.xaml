<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WritingHost.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RichTexteEditor.Controls"
    xmlns:ink="using:InkControl.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Writing Lab — Rich Text + Ink">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Editor commands -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Editor" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <Button x:Name="InsertTodoButton" Content="Insert Todo" Click="InsertTodo_Click" ToolTipService.ToolTip="Insert a [ ] todo checkbox" />
                <Button x:Name="InsertTagButton" Content="Insert Tag" Click="InsertTag_Click" ToolTipService.ToolTip="Insert a #tag chip" />
                <Button x:Name="LoadDemoButton" Content="Load Demo" Click="LoadDemo_Click" ToolTipService.ToolTip="Load a demo document showing formatting and inline elements" />
                <Button x:Name="ClearDocumentButton" Content="Clear" Click="ClearDocument_Click" />
            </StackPanel>

            <!-- Ink commands -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="Ink" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />
                <ComboBox x:Name="BackgroundComboBox" Width="110" SelectionChanged="BackgroundComboBox_SelectionChanged">
                    <ComboBoxItem Content="Blank" IsSelected="True" />
                    <ComboBoxItem Content="Ruled" />
                    <ComboBoxItem Content="Dotted" />
                </ComboBox>
                <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button x:Name="ResetViewButton" Content="Reset View" Click="ResetViewport_Click" />
                <Button x:Name="ClearInkButton" Content="Clear Ink" Click="ClearInk_Click" />
            </StackPanel>
        </Grid>

        <!-- Editor + Ink side by side -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Rich text editor with inline elements -->
            <controls:DocumentEditorControl
                x:Name="DocumentEditor"
                Grid.Column="0"
                PlaceholderText="Start typing...&#x0a;&#x0a;**bold**, *italic*, ~~strikethrough~~&#x0a;#tag for inline tag chips&#x0a;[ ] for todo checkboxes"
                ContentChanged="DocumentEditor_ContentChanged"
                TagClicked="DocumentEditor_TagClicked"
                TodoToggled="DocumentEditor_TodoToggled" />

            <!-- Divider -->
            <Border Grid.Column="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Width="1" HorizontalAlignment="Center" />

            <!-- Native WinAppSDK ink over an infinite world-space viewport. -->
            <ink:InkCanvas
                x:Name="InkSurface"
                Grid.Column="2"
                BgType="Blank"
                BgSpacing="25"
                PenThickness="2"
                IsMouseInkingEnabled="True"
                StrokesChanged="InkSurface_StrokesChanged"
                ViewportChanged="InkSurface_ViewportChanged" />
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="2" Padding="12,6" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock x:Name="StatusText" Text="Ready — type on the left, ink on the right"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="•" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="Pen/mouse to ink; touch/right-drag to pan; Ctrl+Wheel to zoom"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
