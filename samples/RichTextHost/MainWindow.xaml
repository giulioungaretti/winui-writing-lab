<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="RichTexteEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RichTexteEditor"
    xmlns:controls="using:RichTexteEditor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Rich Text Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Height="48" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock 
                Text="Rich Text Editor" 
                Style="{StaticResource SubtitleTextBlockStyle}"
                VerticalAlignment="Center"
                Margin="16,0"/>
            
            <!-- Stats summary in title bar -->
            <StackPanel 
                Grid.Column="1" 
                Orientation="Horizontal" 
                Spacing="16" 
                Margin="0,0,16,0"
                VerticalAlignment="Center">
                <TextBlock 
                    x:Name="TodoSummaryText"
                    Text="○ 0/0"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
                <TextBlock 
                    x:Name="TagSummaryText"
                    Text="#0 tags"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Toolbar -->
        <CommandBar 
            Grid.Row="1" 
            DefaultLabelPosition="Collapsed"
            Background="Transparent">
            
            <AppBarButton Label="Insert Tag" ToolTipService.ToolTip="Insert Tag (#)" Click="InsertTag_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8EC;"/>
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Label="Insert Todo" ToolTipService.ToolTip="Insert Todo ([ ])" Click="InsertTodo_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE73A;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Clear" Label="Clear All" Click="Clear_Click"/>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- Main Editor - Block-based with inline components -->
        <controls:DocumentEditorControl 
            x:Name="DocumentEditor"
            Grid.Row="2"
            PlaceholderText="Start typing...&#x0a;&#x0a;Use #tag to create inline tags&#x0a;Use [ ] to create todos"
            ContentChanged="DocumentEditor_ContentChanged"
            TagClicked="DocumentEditor_TagClicked"
            TodoToggled="DocumentEditor_TodoToggled"/>

        <!-- Quick Input Bar -->
        <Grid 
            Grid.Row="3" 
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="8">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox 
                x:Name="QuickInput"
                Grid.Column="0"
                PlaceholderText="Quick add: #tag or [ ] todo item"
                KeyDown="QuickInput_KeyDown"/>

            <Button 
                Grid.Column="1" 
                Content="Add" 
                Margin="8,0,0,0"
                Click="QuickAdd_Click"
                Style="{StaticResource AccentButtonStyle}"/>
        </Grid>

        <!-- Status Bar -->
        <Grid 
            Grid.Row="4"
            Height="28"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,0">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock 
                x:Name="StatusText"
                Grid.Column="0"
                Text="Ready"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Opacity="0.7"/>

            <TextBlock 
                x:Name="StatsText"
                Grid.Column="1"
                Text=""
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Margin="16,0"
                Opacity="0.7"/>
        </Grid>
    </Grid>
</Window>
